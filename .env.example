# انسخ هذا الملف إلى .env محلياً أو اضبط القيم في لوحة الاستضافة. لا ترفع .env إلى Git.
PORT=3000
JWT_SECRET=REPLACE_WITH_AT_LEAST_64_RANDOM_CHARACTERS
ALLOWED_ORIGINS=http://localhost:3000,https://your-domain.example

# النطاق المنفصل المخصص للوحة الإدارة فقط، مثال: admin.example.com
ADMIN_HOST=admin.example.com
